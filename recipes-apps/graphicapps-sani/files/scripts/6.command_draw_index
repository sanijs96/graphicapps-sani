# add resource for vertex input stage
resource create -n rectangle

resource create -n rectangle_idx

# copy resource to device
temp_buf = cmdbuf alloc -b onetime

cmdbuf add -c copy_resource -i $temp_buf -n rectangle

cmdbuf add -c copy_resource -i $temp_buf -n rectangle_idx

cmdbuf run -i $temp_buf

# allocate command buffer & begin recording
main_buf = cmdbuf alloc -b common

# create pipeline & subpass
pipeline setup -s vertex_input -n rectangle

pipeline_idx = pipeline create

cmdbuf add -c begin_renderpass -i $main_buf

cmdbuf add -c bind_pipeline -i $main_buf -p $pipeline_idx

# resources from vertex_attribute.dat
cmdbuf add -c bind_resource -i $main_buf -n rectangle

cmdbuf add -c bind_resource -i $main_buf -n rectangle_idx

cmdbuf add -c draw -i $main_buf -s index

cmdbuf run -i $main_buf
