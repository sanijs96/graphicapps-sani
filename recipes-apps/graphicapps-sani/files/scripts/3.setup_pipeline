# create subpass & pipeline
pipeline init

# setup vertex shader stage
pipeline setup -s shader_vertex -f /home/root/graphicapps-source/shaders/shader_vert.spv

# setup fragment shader stage
pipeline setup -s shader_fragment -f /home/root/graphicapps-source/shaders/shader_frag.spv

# add resource for vertex input stage
pipeline setup -s vertex_input -n triangle

# setup viewport stage
pipeline setup -s viewport
