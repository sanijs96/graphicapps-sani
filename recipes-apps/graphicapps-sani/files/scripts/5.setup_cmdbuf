buf_idx = cmdbuf alloc

# create pipeline & subpass
pipeline_idx = pipeline create

cmdbuf add -c renderpass -i $buf_idx

cmdbuf add -c bind-pipeline -i $buf_idx -p $pipeline_idx

# resource 'triangle' from vertex_attribute.dat
cmdbuf add -c bind-resource -i $buf_idx -n triangle

cmdbuf add -c draw -i $buf_idx

cmdbuf run -i $buf_idx
