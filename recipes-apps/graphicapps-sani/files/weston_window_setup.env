#!/bin/bash

mkdir -p /tmp/$USER-weston
chmod 0700 /tmp/$USER-weston

mkdir -p /tmp/.X11-unix
chmod 1777 /tmp/.X11-unix

export XDG_RUNTIME_DIR=/tmp/$USER-weston

weston &
sleep 2

export DISPLAY=":0.0"

export CC="aarch64-poky-linux-gcc"
export LDFLAGS="-lvulkan -lglfw -ldl -lpthread -lX11 -lXxf86vm -lXrandr -lXi -lm"

xset s off         # 화면 보호기 off
xset -dpms         # Display power management signaling off
xset s noblank     # 화면 블랭크 off
